#!/bin/sh
# Sonic Screwdriver: start the fork's asteroid-launcher, or the stock one.
# Installed by sonic/deploy.sh as /usr/local/libexec/sonic/launcher, and run by
# the asteroid-launcher.service drop-in sonic.conf in place of
# /usr/bin/asteroid-launcher.
#
# After 3 starts within 2 minutes (a crash loop), it starts the stock launcher
# until the next deploy or reboot. systemd's own limit (5 starts in 10 s) would
# leave the watch without any launcher, so this switch has to come first.
#
# The stock launcher starts silenced, however it comes to run here: a crash
# loop, at boot or later, or no fork build. Its NotificationView plays
# /usr/share/sounds/notification.wav through a QtMultimedia SoundEffect for
# each notification it shows, whatever the profile: at its start, one per
# stored notification, all at once. Only its own process is silenced: the
# speaker isn't muted, since nothing here could safely unmute it later.
ours=/usr/local/lib/sonic-launcher/asteroid-launcher
stock=/usr/bin/asteroid-launcher
state=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
starts=$state/sonic-launcher-starts
fallback=$state/sonic-launcher-fallback

now=$(cut -d. -f1 /proc/uptime)
{ awk -v now="$now" '$1 > now - 120' "$starts" 2>/dev/null; echo "$now"; } > "$starts.new"
mv "$starts.new" "$starts"
if [ "$(wc -l < "$starts")" -gt 3 ] && [ ! -e "$fallback" ]; then
	echo "sonic: the fork's launcher started 3 times in 2 minutes; using the stock launcher" >&2
	: > "$fallback"
fi

if [ -x "$ours" ] && [ ! -e "$fallback" ]; then
	exec "$ours" "$@"
fi

# The launcher's SoundEffect is a PulseAudio client of its own: with no server
# to reach, it plays nothing, and doesn't retry. lipstick's volume control
# reaches PulseAudio over D-Bus, and ngfd plays the profile's sounds from its
# own process: neither changes. fakesink for anything that would play through
# GStreamer's playbin. The apps it starts may inherit both, since invoker
# passes its environment on: in this fallback, they're silent too.
echo "sonic: the stock launcher runs, its own sounds silenced (PULSE_SERVER=unix:/dev/null)" >&2
export PULSE_SERVER=unix:/dev/null QT_GSTREAMER_PLAYBIN_AUDIOSINK=fakesink
exec "$stock" "$@"
